<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:title="Voice Agent" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Status -->
            <com.google.android.material.card.MaterialCardView style="@style/Card"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_status_icon" android:padding="12dp"
                            android:src="@drawable/ic_mic_tinted" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/statusTitle" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                            <TextView android:id="@+id/statusSub" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginVertical="16dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swEnabled"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Always listening" android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                    <TextView android:id="@+id/enabledSub" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Setup -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/setupCard" style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:text="Finish setup" />
                    <LinearLayout android:id="@+id/setupRows" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Brain -->
            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_sparkle" android:importantForAccessibility="no" />
                        <TextView style="@style/CardTitle" android:layout_marginStart="12dp"
                            android:text="Understanding" />
                    </LinearLayout>
                    <TextView android:id="@+id/brainText" style="@style/Body" android:layout_marginTop="8dp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/brainProgress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:visibility="gone" app:trackCornerRadius="4dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
                        <Button android:id="@+id/btnBrainRemove" style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remove" />
                        <Button android:id="@+id/btnBrain" style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="Download · 2.6 GB"
                            app:icon="@drawable/ic_download" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Auto-send upgrade (lite only) -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/upgradeCard" style="@style/Card"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_send" android:importantForAccessibility="no" />
                        <TextView style="@style/CardTitle" android:layout_marginStart="12dp"
                            android:text="Press Send for me" />
                    </LinearLayout>
                    <TextView android:id="@+id/upgradeText" style="@style/Body" android:layout_marginTop="8dp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/upgradeProgress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"
                        app:trackCornerRadius="4dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
                        <Button android:id="@+id/btnUpgradeHelp" style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="How it works" />
                        <Button android:id="@+id/btnUpgrade" style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="Set up" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences -->
            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:text="Preferences" />

                    <TextView style="@style/Label" android:layout_marginTop="12dp" android:text="Language" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/langGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" app:selectionRequired="true" app:singleSelection="true">
                        <Button android:id="@+id/langEn" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="English" />
                        <Button android:id="@+id/langMr" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="मराठी" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/Label" android:text="Spoken replies" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/talkGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" app:selectionRequired="true" app:singleSelection="true">
                        <Button android:id="@+id/talkMinimal" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Only when needed" />
                        <Button android:id="@+id/talkFull" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Confirm everything" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView style="@style/Body" android:text="“Only when needed” answers questions and reports problems; otherwise a short vibration tells you it's done." />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:hint="Wake word"
                        app:helperText="Say it before a command: “Agent, call Mom”">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etWake"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textCapWords" android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swScreenOff"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="Listen when the screen is off" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAutoSend"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Press Send for me" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:hint="Country code for WhatsApp numbers"
                        app:prefixText="+">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCc"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Try it -->
            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:text="Try a command" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilTry"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:hint="e.g. tell Priya I'll be late"
                        app:endIconDrawable="@drawable/ic_send" app:endIconMode="custom"
                        app:endIconContentDescription="Run">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTry"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:imeOptions="actionSend" android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Button android:id="@+id/btnExamples" style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="What can I say?" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/footer" style="@style/Body" android:layout_marginTop="20dp"
                android:gravity="center" android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
